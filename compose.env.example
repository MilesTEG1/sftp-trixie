# ==============================================================================
# ⚙️ Modèle de Variables d'Environnement — sftp-trixie
# ==============================================================================
# Copier ce fichier vers .env ou compose.env avant de lancer le conteneur :
#   cp compose.env.example .env
# ==============================================================================

# 🔌 Port SFTP exposé sur l'hôte (déporté du port SSH standard 22)
SFTP_PORT=2222

# 👤 Nom du premier utilisateur SFTP
SFTP_USER1=demouser

# 🔒 Mot de passe chiffré (hash SHA-512 $6$..., yescrypt $y$..., ou MD5 $1$...)
# Pour générer un hash sécurisé avec Python :
#   docker run --rm python:alpine python -c "import crypt; print(crypt.crypt('VOTRE_MOT_DE_PASSE'))"
SFTP_PASS1=$6$saltexample$dummy_hash_to_replace_with_your_own

# 🆔 Alignement UID et GID avec les permissions du système hôte
SFTP_UID1=1000
SFTP_GID1=1000
